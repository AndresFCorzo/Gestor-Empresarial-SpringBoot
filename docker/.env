# =====================================================
# GESTOR EMPRESARIAL INTEGRADO - VARIABLES DE ENTORNO
# =====================================================
# Autor: Andres Felipe Corzo Angarita
# Fecha: Mayo 2025
# =====================================================

# =====================================================
# CONFIGURACIÓN DE BASE DE DATOS
# =====================================================
# Contraseña del usuario root de MySQL
MYSQL_ROOT_PASSWORD=root

# Nombre de la base de datos
MYSQL_DATABASE=gestor_empresarial

# Usuario y contraseña para la aplicación
MYSQL_USER=gestor_user
MYSQL_PASSWORD=gestor_pass

# =====================================================
# CONFIGURACIÓN DE LA API
# =====================================================
# Puerto de la aplicación
SERVER_PORT=8080

# Configuración de conexión a MySQL
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gestor_empresarial
DB_USERNAME=root
DB_PASSWORD=root

# =====================================================
# CONFIGURACIÓN JWT
# =====================================================
# Clave secreta para firmar tokens JWT
JWT_SECRET=gestorEmpresarialSecretKey2025

# Tiempo de expiración del token (24 horas en milisegundos)
JWT_EXPIRATION=86400000

# =====================================================
# CONFIGURACIÓN DE LOGS
# =====================================================
# Nivel de logging
LOG_LEVEL=INFO

# Directorio de logs
LOG_PATH=/app/logs

# =====================================================
# CONFIGURACIÓN DE PERFILES
# =====================================================
# Perfil activo (dev, prod, docker)
SPRING_PROFILES_ACTIVE=docker

# =====================================================
# CONFIGURACIÓN DE CORS
# =====================================================
# Orígenes permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# =====================================================
# CONFIGURACIÓN DE LA APLICACIÓN
# =====================================================
# Nombre de la aplicación
APP_NAME=Gestor Empresarial Integrado
APP_VERSION=1.0.0

# =====================================================
# DATOS DE PRUEBA
# =====================================================
# Usuario administrador por defecto
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@gestorempresarial.com
DEFAULT_ADMIN_PASSWORD=admin123